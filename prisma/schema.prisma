generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

/**
 * KNOOS User model.
 * role: CUSTOMER | ADMIN
 * Authentication is handled via Google OAuth (next-auth).
 */
model User {
  id        String   @id @default(cuid())
  name      String?
  email     String?  @unique
  googleId  String?  @unique
  password  String?
  image     String?
  phone     String?  @db.VarChar(20)
  role      String   @default("CUSTOMER") @db.VarChar(20)
  createdAt DateTime @default(now()) @db.DateTime(0)
  updatedAt DateTime @updatedAt @db.DateTime(0)

  addresses Address[]
  carts     Cart[]
  orders    Order[]
  reviews   Review[]
  customerPreference CustomerPreference?
  phoneIdentity PhoneAuthIdentity?

  @@index([email])
  @@index([googleId])
  @@index([phone])
}

/**
 * Product category: MEN or WOMEN.
 */
model Product {
  id               String  @id @default(cuid())
  name             String  @db.VarChar(255)
  slug             String  @unique @db.VarChar(255)
  description      String? @db.Text
  gender           String  @db.VarChar(10)
  /**
   * @deprecated Legacy display cache. Use categoryRel -> Category instead.
   * This field is retained for migration backfill only.
   * New code must NOT read or write this field.
   */
  category         String? @db.VarChar(50)
  categoryId       String? @db.VarChar(36)
  color            String? @db.VarChar(50)
  colorGroupKey    String? @db.VarChar(100)
  subCategory      String? @db.VarChar(50)
  upperMaterial    String? @db.VarChar(100)
  innerMaterial    String? @db.VarChar(100)
  sole             String? @db.VarChar(100)
  price            Int
  salePrice        Int?
  costPrice        Float?
  hsnCode          String? @db.VarChar(50)
  gstPercentage    Float?
  packagingLength  Float?
  packagingBreadth Float?
  packagingHeight  Float?
  packagingWeight  Float?
  attributes       Json?

  sku       String   @unique @db.VarChar(100)
  status    String   @default("ACTIVE") @db.VarChar(20)
  createdAt DateTime @default(now()) @db.DateTime(0)
  updatedAt DateTime @updatedAt @db.DateTime(0)

  images     ProductImage[]
  variants   ProductVariant[]
  cartItems  CartItem[]
  orderItems OrderItem[]
  reviews    Review[]
  categoryRel Category? @relation("ProductCategory", fields: [categoryId], references: [id], onDelete: SetNull)

  @@index([gender, status])
  @@index([categoryId])
  @@index([slug])
  @@index([status, createdAt])
  @@index([colorGroupKey])
}

model ProductImage {
  id        String  @id @default(cuid())
  productId String  @db.VarChar(36)
  imageUrl  String  @db.Text
  isVideo   Boolean @default(false)
  sortOrder Int     @default(0)

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId, sortOrder])
}

model ProductVariant {
  id        String @id @default(cuid())
  productId String @db.VarChar(36)
  size      String @db.VarChar(10)
  stock     Int    @default(0)
  sku       String @unique @db.VarChar(100)
  price     Int
  salePrice Int?

  product   Product    @relation(fields: [productId], references: [id], onDelete: Cascade)
  cartItems CartItem[]

  @@unique([productId, size])
  @@index([productId])
}

/**
 * Delivery address linked to a user.
 */
model Address {
  id           String   @id @default(cuid())
  userId       String   @db.VarChar(36)
  label        String   @db.VarChar(20) @default("HOME")
  fullName     String   @db.VarChar(100)
  phone        String   @db.VarChar(20)
  addressLine1 String   @db.VarChar(500)
  addressLine2 String?  @db.VarChar(500)
  landmark     String?  @db.VarChar(200)
  city         String   @db.VarChar(100)
  state        String   @db.VarChar(100)
  postalCode   String   @db.VarChar(10)
  country      String   @db.VarChar(100) @default("India")
  isDefault    Boolean  @default(false)
  createdAt    DateTime @default(now()) @db.DateTime(0)
  updatedAt    DateTime @updatedAt @db.DateTime(0)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([userId, isDefault])
}

/**
 * One cart per user. A user has at most one cart at a time.
 */
model Cart {
  id        String   @id @default(cuid())
  userId    String   @unique @db.VarChar(36)
  createdAt DateTime @default(now()) @db.DateTime(0)
  updatedAt DateTime @updatedAt @db.DateTime(0)

  user  User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  items CartItem[]

  @@index([userId])
}

model CartItem {
  id        String @id @default(cuid())
  cartId    String @db.VarChar(36)
  productId String @db.VarChar(36)
  variantId String @db.VarChar(36)
  quantity  Int

  cart    Cart           @relation(fields: [cartId], references: [id], onDelete: Cascade)
  product Product        @relation(fields: [productId], references: [id], onDelete: Cascade)
  variant ProductVariant @relation(fields: [variantId], references: [id], onDelete: Cascade)

  @@unique([cartId, variantId])
  @@index([cartId])
}

/**
 * Order. Payment and delivery amounts are authoritative server-side values.
 */
model Order {
  id                String   @id @default(cuid())
  userId            String   @db.VarChar(36)
  subtotal          Int
  couponCode        String?  @db.VarChar(50)
  discountAmount    Int      @default(0)
  couponReservationActive Boolean @default(false)
  deliveryCharge    Int
  paymentMethod     String   @default("ONLINE") @db.VarChar(20)
  total             Int
  deliveryMethod    String   @db.VarChar(20)
  checkoutMode      String   @default("CART") @db.VarChar(20)
  orderStatus       String   @default("PENDING") @db.VarChar(20)
  paymentStatus     String   @default("PENDING") @db.VarChar(20)
  razorpayOrderId   String?  @unique @db.VarChar(100)
  razorpayPaymentId String?  @unique @db.VarChar(100)
  razorpaySignature String?
  createdAt         DateTime @default(now()) @db.DateTime(0)
  updatedAt         DateTime @updatedAt @db.DateTime(0)

  user    User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  items   OrderItem[]
  address OrderAddress?

  @@index([userId, createdAt])
  @@index([orderStatus, paymentStatus])
}

/**
 * Snapshot of the delivery address at the time of order creation.
 */
model OrderAddress {
  id      String @id @default(cuid())
  orderId String @unique @db.VarChar(36)
  name    String @db.VarChar(100)
  phone   String @db.VarChar(20)
  address String @db.VarChar(500)
  city    String @db.VarChar(100)
  state   String @db.VarChar(100)
  pincode String @db.VarChar(10)

  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)
}

/**
 * Snapshot of a product at purchase time.
 * productName, size, price are denormalised so historical orders are immutable
 * even if the product is later edited.
 */
model OrderItem {
  id          String  @id @default(cuid())
  orderId     String  @db.VarChar(36)
  productId   String? @db.VarChar(36)
  productName String  @db.VarChar(255)
  size        String  @db.VarChar(10)
  quantity    Int
  price       Int
  total       Int

  product Product? @relation(fields: [productId], references: [id], onDelete: SetNull)
  order   Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([orderId])
  @@index([productId])
}

model FAQ {
  id        String   @id @default(cuid())
  question  String   @db.Text
  answer    String   @db.Text
  order     Int      @default(0)
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now()) @db.DateTime(0)
  updatedAt DateTime @updatedAt @db.DateTime(0)
}

model Review {
  id               String   @id @default(cuid())
  productId        String   @db.VarChar(36)
  userId           String?  @db.VarChar(36)
  displayName      String   @db.VarChar(100)
  rating           Int
  reviewText       String   @db.Text
  moderationStatus String   @default("PENDING") @db.VarChar(20)
  customerPhotoUrl String?  @db.VarChar(500)
  productPhotoUrl  String?  @db.VarChar(500)
  isActive         Boolean  @default(false)
  createdAt        DateTime @default(now()) @db.DateTime(0)
  updatedAt        DateTime @updatedAt @db.DateTime(0)

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  user    User?   @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([productId])
  @@index([userId])
  @@index([moderationStatus])
  @@index([productId, moderationStatus])
}

/**
 * Product category managed by admin.
 * Products reference a Category via categoryId.
 * The legacy Product.category string field is kept as a denormalized display cache
 * during migration and will be removed once fully migrated.
 */
model Category {
  id        String   @id @default(uuid())
  name      String   @unique @db.VarChar(50)
  slug      String   @unique @db.VarChar(50)
  isActive  Boolean  @default(true)
  sortOrder Int      @default(0)
  createdAt DateTime @default(now()) @db.DateTime(0)
  updatedAt DateTime @updatedAt @db.DateTime(0)

  products Product[] @relation("ProductCategory")

  @@index([sortOrder])
}

/**
 * Admin-managed coupon definition.
 * Monetary values are stored as whole INR rupees.
 * Redemption tracking and order snapshots are added when checkout integration is introduced.
 */
model Coupon {
  id             String    @id @default(cuid())
  code           String    @unique @db.VarChar(50)
  type           String    @db.VarChar(20)
  discountValue  Int
  minOrderAmount Int?
  maxDiscount    Int?
  startDate      DateTime? @db.DateTime(0)
  endDate        DateTime? @db.DateTime(0)
  usageLimit     Int?
  usageCount     Int       @default(0)
  reservedCount  Int       @default(0)
  isActive       Boolean   @default(true)
  createdAt      DateTime  @default(now()) @db.DateTime(0)
  updatedAt      DateTime  @updatedAt @db.DateTime(0)

  @@index([isActive])
  @@index([startDate, endDate])
}

/**
 * Server-side database-backed OTP challenge for phone login.
 * Single-use, short expiry, cooldown enforced, never stores plaintext OTP.
 */
model OtpChallenge {
  id         String   @id @default(cuid())
  phone      String   @unique @db.VarChar(20)
  codeHash   String   @db.VarChar(255)
  expiresAt  DateTime @db.DateTime(0)
  attempts   Int      @default(0)
  lastSentAt DateTime @default(now()) @db.DateTime(0)
  createdAt  DateTime @default(now()) @db.DateTime(0)
  updatedAt  DateTime @updatedAt @db.DateTime(0)

  @@index([phone])
}

/**
 * Customer preference section titled "Let Us Know".
 * Stores customer shopping preferences: Name (in User.name), Gender, and Shoe Size.
 */
model CustomerPreference {
  id               String   @id @default(cuid())
  userId           String   @unique @db.VarChar(36)
  genderPreference String?  @db.VarChar(50)
  shoeSize         String?  @db.VarChar(20)
  createdAt        DateTime @default(now()) @db.DateTime(0)
  updatedAt        DateTime @updatedAt @db.DateTime(0)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

/**
 * Authoritative OTP verified phone identity for customer authentication.
 * Distinct from User.phone, which remains an unverified profile/contact field.
 * Phone is strictly unique at the database level to prevent race conditions.
 */
model PhoneAuthIdentity {
  id         String   @id @default(cuid())
  phone      String   @unique @db.VarChar(20)
  userId     String   @unique @db.VarChar(36)
  verifiedAt DateTime @default(now()) @db.DateTime(0)
  createdAt  DateTime @default(now()) @db.DateTime(0)
  updatedAt  DateTime @updatedAt @db.DateTime(0)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}


